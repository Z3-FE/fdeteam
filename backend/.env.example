# 复制为 .env 并填入你的硅基流动 API Key
# 没有填 key 时后端自动进入 MOCK 模式（走内置脚本，方便先跑通前后端联调）

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=deepseek-ai/DeepSeek-V3

# 留空走 MOCK；填了 key 自动用真实模型。也可强制 MOCK=1
MOCK=

# SQLite 数据库文件路径（P0 用 SQLite，零配置；将来可换 Postgres）
DB_PATH=./data/app.db

# 允许的前端来源（逗号分隔），dev 下用 Vite 代理可不改
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
