# 复制为 .env 并填入你的硅基流动 API Key
# 没有填 key 时后端自动进入 MOCK 模式（走内置脚本，方便先跑通前后端联调）

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=deepseek-ai/DeepSeek-V3

# 留空走 MOCK；填了 key 自动用真实模型。也可强制 MOCK=1
MOCK=

# SQLite 数据库文件路径（P0 用 SQLite，零配置；将来可换 Postgres）
DB_PATH=./data/app.db

# 允许的前端来源（逗号分隔），dev 下用 Vite 代理可不改
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 微信小程序登录：小程序后台「开发管理 → 开发设置」里的 AppID 和 AppSecret。
# 不填则不登录，报告只能按设备上存的会话找回。AppSecret 只放后端，不要写进前端。
WX_APPID=
WX_SECRET=

# 阿里云号码认证服务（短信认证）：保存报告时给手机号发验证码，用 SendSmsVerifyCode 发、CheckSmsVerifyCode 验。
# 签名和模板用号码认证控制台「短信认证」里系统赠送的（如签名 恒创联众、模板 100001），模板变量 ${code} 和 ${min}。
# 四项都填才真发短信；留空时验证码由后端生成并只打印在后端日志里（开发联调用）。
# AccessKey 建议用只授权了 AliyunDypnsFullAccess 的 RAM 子账号，只放后端，不要写进前端。
# 也可以改用 ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET 这两个名字。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
